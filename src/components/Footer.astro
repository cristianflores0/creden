---
import { Image } from 'astro:assets';
import logo from '../assets/logos/Recurso 3.png';
import pci from '../assets/icons/PCI dss.png';
import isae from '../assets/icons/Isae.png';
---

<footer class="bg-[#211818] px-6 py-10 text-white">
  <div class="content grid gap-8 md:grid-cols-[1fr_1.2fr_1.1fr_1fr]">
    <nav class="space-y-3 text-center text-[11px] uppercase md:text-left">
      <p class="mb-5 text-white/85">Soluciones</p>
      <a class="block text-white/75" href="#procesamiento">Procesamiento</a>
      <a class="block text-white/75" href="#emision">Emisión</a>
      <a class="block text-white/75" href="#adquirencia">Adquirencia</a>
    </nav>

    <nav class="space-y-3 text-center text-[11px] uppercase md:text-left">
      <p class="mb-5 text-white/85">Sobre Credencial Payments</p>
      <a class="block text-white/75" href="#nosotros">Nosotros</a>
      <a class="block text-white/75" href="#contacto">Contacto</a>
      <a class="block text-white/75" href="#">Legales</a>
    </nav>

    <div class="text-center text-[11px] md:text-left">
      <p class="mb-4 text-white/85">Síguenos en LinkedIn</p>
      <p class="mb-5 text-white/75">@credencialpayments</p>
      <div class="flex justify-center gap-4 md:justify-start">
        <Image src={pci} alt="PCI DSS" class="h-9 w-auto brightness-0 invert" />
        <Image src={isae} alt="ISAE 3402" class="h-9 w-auto brightness-0 invert" />
      </div>
    </div>

    <div class="flex items-start justify-center md:justify-end">
      <Image src={logo} alt="Credencial Payments" class="h-9 w-auto brightness-0 invert" />
    </div>
  </div>

  <p class="content mt-10 max-w-[880px] text-center text-[9px] leading-relaxed text-white/55">
    Argentina: Suipacha 1111, CABA. San Nicolás, Ciudad Autónoma de Buenos Aires. Tel. +54 1130-5000<br />
    México: Insurgentes Sur 734, Piso 1, Colonia del Valle, CDMX. Uruguay: Juan Carlos Gómez 1492. Uruguay 11000.
  </p>
</footer>
