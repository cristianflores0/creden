---
import { Image } from 'astro:assets';
import tarjetas from '../assets/icons/Tarjetas.png';
import paises from '../assets/icons/Paises.png';
import transacciones from '../assets/icons/Transacciones.png';
import dataCenter from '../assets/icons/Data Center.png';
import oficinas from '../assets/icons/Oficinas.png';
import fondoNuestraPresencia from '../assets/images/Fondo Nuestra Presencia.png';
import vale from '../assets/logos/Vale.png';
import binance from '../assets/logos/Binance.png';
import astropay from '../assets/logos/AstroPay.png';
import broxel from '../assets/logos/Broxel.png';
import bit2me from '../assets/logos/Bit2me.png';
import gateio from '../assets/logos/GateIo.png';
import westernUnion from '../assets/logos/Western Union Logo.png';
import financoop from '../assets/logos/Financoop.png';
---

<section id="nosotros" class="dark-band">
  <div class="px-6 py-16 md:px-12 md:py-24" style={`background-image: linear-gradient(rgba(10,12,15,.72), rgba(10,12,15,.88)), url('${fondoNuestraPresencia.src}'); background-size: cover; background-position: center;`}>
    <div class="content">
      <h2 class="mb-12 text-center text-[24px] font-medium text-white md:text-[30px]">Nuestra presencia</h2>

      <div class="grid gap-7 md:grid-cols-3">
        <article class="cut-card grid min-h-[170px] grid-cols-[1fr_auto] bg-[#292b2f]/80 p-7 shadow-[0_12px_25px_rgba(0,0,0,.18)]">
          <p class="self-center text-[52px] font-semibold leading-none text-white">+18<span class="text-[32px]">M</span></p>
          <Image src={tarjetas} alt="" aria-hidden="true" class="h-11 w-11 object-contain" />
          <p class="col-start-2 self-end text-right text-[11px] leading-tight text-white">de tarjetas procesadas<br />en la región</p>
        </article>
        <article class="cut-card grid min-h-[170px] grid-cols-[1fr_auto] bg-[#292b2f]/80 p-7 shadow-[0_12px_25px_rgba(0,0,0,.18)]">
          <p class="self-center text-[52px] font-semibold leading-none text-white">15</p>
          <Image src={paises} alt="" aria-hidden="true" class="h-11 w-11 object-contain" />
          <p class="col-start-2 self-end text-right text-[11px] leading-tight text-white">países de LATAM donde<br />estamos homologados</p>
        </article>
        <article class="cut-card grid min-h-[170px] grid-cols-[1fr_auto] bg-[#292b2f]/80 p-7 shadow-[0_12px_25px_rgba(0,0,0,.18)]">
          <p class="self-center text-[52px] font-semibold leading-none text-white">+170<span class="text-[32px]">M</span></p>
          <Image src={transacciones} alt="" aria-hidden="true" class="h-11 w-11 object-contain" />
          <p class="col-start-2 self-end text-right text-[11px] leading-tight text-white">transacciones mensuales</p>
        </article>
        <article class="cut-card grid min-h-[170px] grid-cols-[1fr_auto] bg-[#292b2f]/80 p-7 shadow-[0_12px_25px_rgba(0,0,0,.18)]">
          <p class="self-center text-[52px] font-semibold leading-none text-white">+2<span class="text-[32px]">B</span></p>
          <Image src={transacciones} alt="" aria-hidden="true" class="h-11 w-11 object-contain" />
          <p class="col-start-2 self-end text-right text-[11px] leading-tight text-white">de transacciones anuales</p>
        </article>
        <article class="cut-card grid min-h-[170px] grid-cols-[1fr_auto] bg-[#292b2f]/80 p-7 shadow-[0_12px_25px_rgba(0,0,0,.18)]">
          <p class="self-center text-[52px] font-semibold leading-none text-white">4</p>
          <Image src={dataCenter} alt="" aria-hidden="true" class="h-11 w-11 object-contain" />
          <p class="col-start-2 self-end text-right text-[11px] leading-tight text-white">data centers distribuidos por<br />México, Estados Unidos y Argentina</p>
        </article>
        <article class="cut-card grid min-h-[170px] grid-cols-[1fr_auto] bg-[#292b2f]/80 p-7 shadow-[0_12px_25px_rgba(0,0,0,.18)]">
          <p class="self-center text-[52px] font-semibold leading-none text-white">3</p>
          <Image src={oficinas} alt="" aria-hidden="true" class="h-11 w-11 object-contain" />
          <p class="col-start-2 self-end text-right text-[11px] leading-tight text-white">oficinas comerciales en<br />Ecuador, México y Argentina</p>
        </article>
      </div>
    </div>
  </div>

  <div class="bg-[#1a1b1c] py-10">
    <h2 class="mb-7 text-center text-[24px] font-medium text-white">Confían en nosotros</h2>
    <div class="logo-strip">
      <Image src={vale} alt="Vale" />
      <Image src={binance} alt="Binance" />
      <Image src={astropay} alt="AstroPay" />
      <Image src={broxel} alt="Broxel" />
      <Image src={bit2me} alt="Bit2me" />
      <Image src={gateio} alt="Gate.io" />
      <Image src={westernUnion} alt="Western Union" />
      <Image src={financoop} alt="Financoop" />
    </div>
  </div>
</section>
