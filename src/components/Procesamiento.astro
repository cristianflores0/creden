---
import { Image } from 'astro:assets';
import iconProcesamiento from '../assets/icons/Procesamiento.png';
import iconMonitoreo from '../assets/icons/Monitoreo.png';
import iconScoring from '../assets/icons/Scoring.png';
import iconGestion from '../assets/icons/Gestion.png';
import iconPCI from '../assets/icons/PCI dss.png';
import iconIsae from '../assets/icons/Isae.png';
import iconCNBV from '../assets/icons/CNBV.png';
import iconSAT from '../assets/icons/SAT.png';
import iconArgentina from '../assets/icons/Banco Central Republica Argentina.png';
import iconUruguay from '../assets/icons/Banco Central del Uruguay.png';
import iconEcuador from '../assets/icons/Banco Central del Ecuador.png';
---

<section class="section-band" id="procesamiento">
  <div class="content section-panel rounded-t-none">
    <div class="bg-[var(--soft)] px-6 pb-10 pt-7 md:px-16 md:pb-12 md:pt-8">
      <p class="mb-2 text-center text-[14px] text-[#85868c]">
        Pagos rápidos y seguros en transacciones nacionales e internacionales con
      </p>
      <div class="pill-row mb-12">
        <span class="blue-pill"><strong>99,9%</strong> Eficiencia operativa</span>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <Image src={iconProcesamiento} alt="" aria-hidden="true" />
          <p>Procesamiento de transacciones nacionales e internacionales.</p>
        </article>
        <article class="feature-card">
          <Image src={iconMonitoreo} alt="" aria-hidden="true" />
          <p>Monitoreo en tiempo real de compras y operaciones.</p>
        </article>
        <article class="feature-card">
          <Image src={iconScoring} alt="" aria-hidden="true" />
          <p>Scoring crediticio inteligente para evaluar solvencia y riesgo.</p>
        </article>
        <article class="feature-card">
          <Image src={iconGestion} alt="" aria-hidden="true" />
          <p>Gestión y autorización de pagos con máxima eficiencia.</p>
        </article>
      </div>

      <div class="mt-12 -mx-6 md:-mx-16 px-6 md:px-16 grid grid-cols-7 gap-6 items-center">
        <Image src={iconPCI} alt="PCI DSS" class="h-16 w-auto object-contain" />
        <Image src={iconIsae} alt="ISAE 3402" class="h-16 w-auto object-contain" />
        <Image src={iconCNBV} alt="CNBV" class="h-16 w-auto object-contain" />
        <Image src={iconSAT} alt="SAT" class="h-16 w-auto object-contain" />
        <Image src={iconArgentina} alt="Banco Central República Argentina" class="h-16 w-auto object-contain" />
        <Image src={iconUruguay} alt="Banco Central del Uruguay" class="h-16 w-auto object-contain" />
        <Image src={iconEcuador} alt="Banco Central del Ecuador" class="h-16 w-auto object-contain" />
      </div>

      <p class="mt-8 text-center text-[19px] leading-snug text-[#6c6d73]">
        Somos una compañía regulada por los bancos centrales y entes reguladores en los países donde operamos.
      </p>

      <div class="mt-9 grid gap-4 md:grid-cols-4">
        <div class="rounded-[4px] bg-[#101011] px-5 py-5 text-center text-[13px] font-medium text-white">Cumplimiento<br />de normativas</div>
        <div class="rounded-[4px] bg-[#101011] px-5 py-5 text-center text-[13px] font-medium text-white">Certificaciones locales<br />e internacionales</div>
        <div class="rounded-[4px] bg-[#101011] px-5 py-5 text-center text-[13px] font-medium text-white">Planes de<br />contingencia</div>
        <div class="rounded-[4px] bg-[var(--green)] px-5 py-5 text-center text-[13px] font-medium text-white">Resguardo de<br />datos sensibles</div>
      </div>
    </div>
  </div>
</section>

